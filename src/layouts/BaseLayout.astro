---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * Widen the content column (header, footer and sections together) for pages
   * whose content is data rather than prose — see --page-max in global.css.
   */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class:list={["min-h-screen bg-canvas text-body", wide && "page-wide"]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-heading focus:shadow-md focus:ring-2 focus:ring-accent"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
