---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="border-y border-border bg-band"
>
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
    <div aria-hidden="true" class="h-0.5 w-8 rounded-full bg-accent"></div>
    <h2
      id="projects-heading"
      class="mt-4 text-2xl font-semibold tracking-tight text-heading"
    >
      Projects
    </h2>
    <p class="mt-2 max-w-2xl text-muted">
      A few things I'm building to learn in the open — an AI data-analyst agent
      and the infrastructure to ship it.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
