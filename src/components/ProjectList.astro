---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import TimecardMiniViz from "./TimecardMiniViz.astro";
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="border-y border-border bg-band"
>
  <div class="page-shell py-14 md:py-20">
    <div aria-hidden="true" class="h-0.5 w-8 rounded-full bg-accent"></div>
    <h2
      id="projects-heading"
      class="mt-4 text-2xl font-semibold tracking-tight text-heading"
    >
      Projects
    </h2>
    <p class="mt-2 max-w-2xl text-muted">
      An AI agent I built in the open, and two systems running in production at
      work. All three turn a pile of data into something a person can act on.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard project={project}>
            {project.slug === "timecard-visualizer" && (
              <Fragment slot="extra">
                <TimecardMiniViz />
              </Fragment>
            )}
          </ProjectCard>
        ))
      }
    </div>
  </div>
</section>
