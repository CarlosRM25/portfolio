---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="border-y border-stone-200 bg-stone-50"
>
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
    <h2
      id="projects-heading"
      class="text-2xl font-semibold tracking-tight text-stone-900"
    >
      Projects
    </h2>
    <p class="mt-2 max-w-2xl text-stone-600">
      A few things I'm building to learn in the open — an AI data-analyst agent
      and the infrastructure to ship it.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
