---
import { profile } from "../data/profile";

/**
 * Nav hrefs are root-relative rather than bare fragments so they still work
 * from /demo — a plain "#projects" would scroll nowhere on any page but the
 * home page.
 */
const links = [
  { label: "Projects", href: "/#projects" },
  { label: "Demo", href: "/demo" },
  { label: "About", href: "/#about" },
];

// Mark the demo as the current page (fragments never count as a match).
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  id="top"
  class="sticky top-0 z-50 border-b border-border bg-canvas/80 backdrop-blur"
>
  <div
    class="page-shell flex h-16 items-center justify-between gap-4"
  >
    <a
      href="/"
      class="rounded-sm text-sm font-semibold tracking-tight text-heading"
    >
      {profile.name}
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.href === path ? "page" : undefined}
            class="hidden rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-accent-text aria-[current=page]:text-accent-text md:inline-block"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={profile.resumePath}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-border-strong px-3 py-1.5 text-sm font-medium text-body transition-colors hover:border-accent hover:text-accent-text"
      >
        Résumé
      </a>
    </nav>
  </div>
</header>
