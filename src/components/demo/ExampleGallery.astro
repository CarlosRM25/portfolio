---
/**
 * The pre-run gallery: eight real answers, pickable from a list.
 *
 * Everything here is rendered at build time from src/data/examples.json — no
 * fetch, no backend, no chart CDN. Read the answers with the network off and
 * they are all still there.
 *
 * Without JS every panel is simply visible (a long page, but a complete one).
 * The inline bootstrap below collapses it to one panel before first paint.
 */
import examples from "../../data/examples.json";
import { renderAnswer } from "../../lib/answer-md";
import type { ChartSpec } from "../../lib/chart-svg";
import ChartFigure from "./ChartFigure.astro";

type Example = {
  id: string;
  question: string;
  answer: string;
  sql: string[];
  chart: ChartSpec | null;
};

const items = examples as Example[];
---

<section id="examples" aria-labelledby="examples-heading" class="page-shell py-14 md:py-20">
  <div aria-hidden="true" class="h-0.5 w-8 rounded-full bg-accent"></div>
  <h2
    id="examples-heading"
    class="mt-4 text-2xl font-semibold tracking-tight text-heading"
  >
    {items.length} questions it has already answered
  </h2>
  <p class="mt-2 max-w-2xl text-muted">
    Real runs against the live database, captured ahead of time. Pick one — the
    answer, the chart and the SQL the agent wrote are all here, and none of it
    touches the network.
  </p>

  <div class="mt-8 gap-8 md:grid md:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] md:items-start">
    <div
      role="tablist"
      aria-label="Example questions"
      aria-orientation="vertical"
      class="flex flex-col gap-1 md:sticky md:top-20"
    >
      {
        items.map((item, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${i}`}
            aria-controls={`panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="group flex w-full items-start gap-3 rounded-lg border border-transparent border-l-2 px-3 py-2.5 text-left transition-colors hover:bg-white/5 aria-selected:border-border aria-selected:border-l-accent aria-selected:bg-surface"
          >
            <span class="mt-0.5 text-xs font-semibold text-faint tabular-nums group-aria-selected:text-accent-text">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm leading-snug text-muted group-aria-selected:text-heading">
                {item.question}
              </span>
              <span class="mt-1 flex flex-wrap gap-2 text-[0.65rem] tracking-wide text-faint uppercase">
                {item.sql.length > 0 && (
                  <span>
                    {item.sql.length} {item.sql.length === 1 ? "query" : "queries"}
                  </span>
                )}
                {item.chart && <span>chart</span>}
                {item.sql.length === 0 && !item.chart && <span>model call</span>}
              </span>
            </span>
          </button>
        ))
      }
    </div>

    {/* flex + gap so the no-JS stack is spaced, but a hidden panel (display:
        none) leaves no gap behind it once the script collapses the list. */}
    <div class="mt-6 flex flex-col gap-6 md:mt-0">
      {
        items.map((item, i) => (
          <div
            role="tabpanel"
            id={`panel-${i}`}
            aria-labelledby={`tab-${i}`}
            tabindex="0"
            class="rounded-xl border border-border bg-surface p-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:p-7"
          >
            <p class="text-xs tracking-wider text-faint uppercase">Question</p>
            <p class="mt-1.5 text-base leading-relaxed font-medium text-heading">
              {item.question}
            </p>

            <hr class="my-5 border-border" />

            <p class="text-xs tracking-wider text-faint uppercase">Answer</p>
            <div class="mt-3 answer-prose" set:html={renderAnswer(item.answer)} />

            <ChartFigure spec={item.chart} />

            {item.sql.length > 0 && (
              <details class="sql-panel">
                <summary>
                  The SQL it wrote
                  {item.sql.length > 1 ? ` (${item.sql.length} queries)` : ""}
                </summary>
                {item.sql.map((query) => (
                  <pre>{query.trim()}</pre>
                ))}
              </details>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

{/* Inline so the eight panels collapse to one during parse, not after paint. */}
<script is:inline>
  (() => {
    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
    const panels = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls")),
    );
    if (!tabs.length) return;

    function select(index, { focus = false, reveal = false } = {}) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
      // On narrow screens the panel sits below the list, so a pick that leaves
      // the answer offscreen needs to bring it into view.
      if (reveal && window.matchMedia("(max-width: 767px)").matches) {
        panels[index]?.scrollIntoView({ block: "start", behavior: "smooth" });
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, { reveal: true }));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[
          event.key
        ];
        let next = null;
        if (step) next = (i + step + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        if (next === null) return;
        event.preventDefault();
        select(next, { focus: true });
      });
    });

    select(0);
  })();
</script>
