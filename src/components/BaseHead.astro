---
/**
 * <head> contents: charset, viewport, favicon, SEO + Open Graph meta.
 * og:image is deferred for v1.
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carlos Rubio-Marroquin · Data Science",
  description = "Carlos Rubio-Marroquin is a data science student at the University of Washington. Projects in AI agents, analytics, and data visualization.",
} = Astro.props;

// Astro.site is set in astro.config.mjs; fall back gracefully if it isn't.
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
// Social share image (1200×630), generated by scripts/generate-og.mjs.
const ogImageURL = Astro.site ? new URL("/og.png", Astro.site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#17130f" />

<title>{title}</title>
<meta name="description" content={description} />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
{ogImageURL && <meta property="og:image" content={ogImageURL} />}
{ogImageURL && <meta property="og:image:width" content="1200" />}
{ogImageURL && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
