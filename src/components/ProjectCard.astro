---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;

// Treat empty / whitespace-only strings in the data file as "not set".
const clean = (v?: string) => (v && v.trim() ? v.trim() : undefined);
const image = clean(project.image);
const repo = clean(project.repoUrl);
const demo = clean(project.demoUrl);
const writeup = clean(project.writeupUrl);

const statusStyles: Record<Project["status"], string> = {
  live: "bg-green-500/10 text-green-400 ring-green-500/25",
  building: "bg-accent-subtle text-accent-text ring-accent/25",
  planned: "bg-white/5 text-muted ring-white/15",
};
const statusLabel: Record<Project["status"], string> = {
  live: "Live",
  building: "Building",
  planned: "Planned",
};

const links = [
  repo && { label: "GitHub", href: repo },
  demo && { label: "Live demo", href: demo },
  writeup && { label: "Write-up", href: writeup },
].filter(Boolean) as { label: string; href: string }[];
---

<article
  class:list={[
    "relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface",
    repo && "transition-colors hover:border-border-strong",
  ]}
>
  {
    image ? (
      <img
        src={image}
        alt=""
        loading="lazy"
        width="640"
        height="320"
        class="aspect-[2/1] w-full border-b border-border object-cover"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex aspect-[2/1] w-full items-center justify-center border-b border-border bg-band text-faint"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-8 w-8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="9" cy="9" r="1.75" />
          <path d="m21 15-4.5-4.5L6 21" />
        </svg>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold tracking-tight text-heading">
        {project.title}
      </h3>
      <span
        class:list={[
          "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset",
          statusStyles[project.status],
        ]}
      >
        {statusLabel[project.status]}
      </span>
    </div>

    <p class="mt-3 text-sm leading-relaxed text-muted">{project.blurb}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        project.stack.map((tech) => (
          <li class="rounded-md bg-white/5 px-2 py-1 text-xs font-medium text-muted ring-1 ring-inset ring-white/10">
            {tech}
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex-1"></div>

    {
      links.length > 0 && (
        <div class="flex flex-wrap gap-4 border-t border-border pt-4">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10 inline-flex items-center gap-1 text-sm font-medium text-accent-text underline-offset-2 hover:text-accent-hover hover:underline"
            >
              {link.label}
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    repo && (
      <a
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0"
        aria-label={`${project.title} — GitHub repository`}
      />
    )
  }
</article>
