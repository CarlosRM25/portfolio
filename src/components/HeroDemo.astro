---
/**
 * The hero's visual anchor (peer/boss feedback, 2026-09-11: a static portrait
 * doesn't compete for attention; the page needs one visual/motion element that
 * pulls the eye before the visitor reads anything).
 *
 * Reuses the exact chart the /demo gallery renders. ChartFigure + chart-svg
 * draw it identically here, at build time, from the same examples.json. No
 * screenshot to keep in sync with a future prompt/data change: if the answer
 * changes, this card changes with it on the next build.
 *
 * chart-svg's <text class="tick">/"endpoint"/"axis-title"> elements carry no
 * inline fill; they rely on demo.css's `.chart .tick { fill: ... }` rules for
 * color, and that stylesheet was only ever imported by /demo. Outside that
 * page (here, on the homepage) those classes matched nothing, so the numbers
 * fell back to the SVG spec's default text fill, black, against a dark card:
 * unreadable. Importing the same stylesheet chart-svg already depends on
 * fixes it without hand-copying its rules somewhere they can drift out of
 * sync; demo.css's other rules are namespaced under chart, ask-panel, and
 * sql-panel class prefixes and don't touch anything else this page renders.
 */
import examples from "../data/examples.json";
import ChartFigure from "./demo/ChartFigure.astro";
import "../styles/demo.css";

const example = examples.find((e) => e.id === "office-trend")!;
---

<a
  href="/demo#examples"
  class="relative block rounded-2xl border border-border bg-surface p-5 shadow-sm transition-colors hover:border-accent/50"
>
  <div
    aria-hidden="true"
    class="absolute -right-3 -bottom-3 -z-10 h-full w-full rounded-2xl bg-accent/15"
  >
  </div>

  <p class="font-mono text-xs text-accent-text">
    Live from the Agentic Data Analyst
  </p>
  <p class="mt-2 text-sm leading-snug text-body">{example.question}</p>

  <div class="mt-3 hero-chart">
    <ChartFigure spec={example.chart} />
  </div>

  {/*
    No trailing arrow. The whole card is already the link, so the arrow was
    saying a second time what the cursor and the hover border say once, and an
    arrow tacked onto link text is a stock flourish rather than information.
    The card's inner links keep theirs, because those distinguish an external
    destination from an internal one.
  */}
  <p class="mt-3 text-sm font-medium text-accent-text">Try it yourself</p>
</a>

<style>
  /* The gallery's chart is sized for a full demo page; scale it down and drop
     the hover "show the numbers" affordance here; the hero card is a preview,
     not the interactive chart itself (that's what the link is for). */
  .hero-chart :global(svg) {
    max-height: 220px;
    width: 100%;
  }
  .hero-chart :global(details.chart-data) {
    display: none;
  }

  /*
    demo.css gives charts a 600px floor below 640px wide and lets them scroll,
    so axis values stay readable on /demo where the chart is the content and
    you read numbers off it. In this card the chart is a hook, and that rule
    cut it in half: 285px of 608px visible, with a scrollbar inside the hero.
    Half a chart is not a hook. Let it scale to fit instead; the labels go
    small, which is fine, because nobody reads values here. They tap through.
  */
  @media (max-width: 640px) {
    .hero-chart :global(.chart-plot) {
      overflow-x: visible;
    }

    .hero-chart :global(.chart-plot svg) {
      min-width: 0;
    }
  }
</style>
