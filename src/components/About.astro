---
import { profile } from "../data/profile";
const { education, skills } = profile;
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="mx-auto max-w-5xl px-6 py-14 md:py-20"
>
  <h2
    id="about-heading"
    class="text-2xl font-semibold tracking-tight text-stone-900"
  >
    About
  </h2>

  <div class="mt-6 max-w-2xl space-y-4 leading-relaxed text-stone-600">
    <p>
      Carlos is a data science student at the University of Washington who works
      at the intersection of machine learning and data visualization, with a
      focus on turning analysis into decisions people can act on. He's drawn to
      mission-driven and civic technology.
    </p>
    <p>
      At FCP Insight he builds Python dashboards and data tooling that surface
      operational trends and inform planning decisions — and he's looking for
      new-grad roles where modeling and clear communication both matter.
    </p>
  </div>

  <div class="mt-12 grid gap-10 sm:grid-cols-2">
    <div>
      <h3
        class="text-xs font-semibold tracking-wider text-stone-500 uppercase"
      >
        Skills
      </h3>
      <dl class="mt-4 space-y-3">
        {
          skills.map((group) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 text-sm">
              <dt class="text-stone-500">{group.group}</dt>
              <dd class="text-stone-800">{group.items.join(", ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <h3
        class="text-xs font-semibold tracking-wider text-stone-500 uppercase"
      >
        Education
      </h3>
      <div class="mt-4 space-y-1 text-sm leading-relaxed text-stone-800">
        <p class="font-medium text-stone-900">{education.school}</p>
        <p>{education.degree}</p>
        <p>Minor in {education.minor}</p>
        <p>{education.grad} · GPA {education.gpa}</p>
        {education.honors.map((honor) => <p>{honor}</p>)}
      </div>
    </div>
  </div>
</section>
