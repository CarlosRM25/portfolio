---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="mt-16 border-t border-border">
  <div
    class="mx-auto flex max-w-5xl flex-col-reverse items-center justify-between gap-6 px-6 py-10 text-sm text-muted sm:flex-row"
  >
    <div class="flex flex-col items-center gap-1 sm:items-start">
      <p>
        Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-body underline-offset-2 hover:text-accent-text hover:underline"
          >Astro</a
        >, deployed on <a
          href="https://vercel.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-body underline-offset-2 hover:text-accent-text hover:underline"
          >Vercel</a
        >.
      </p>
      <p>&copy; 2026 Carlos Rubio-Marroquin</p>
    </div>

    <SocialLinks />
  </div>
</footer>
