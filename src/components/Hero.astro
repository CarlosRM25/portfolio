---
import { profile } from "../data/profile";
import SocialLinks from "./SocialLinks.astro";
---

<section
  aria-labelledby="hero-name"
  class="relative isolate overflow-hidden"
>
  {/* Warm ambient glow, upper-right. Purely decorative. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-[-20%] -z-10 h-[30rem] w-[30rem] rounded-full bg-accent/10 blur-3xl sm:right-[-5%] md:right-[6%]"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 pt-16 pb-14 md:pt-24 md:pb-20">
    <div class="md:flex md:flex-row-reverse md:items-center md:gap-14">
      {/* Portrait. Hidden on mobile until a real photo is set; the monogram
          placeholder still shows on md+ so the hero stays balanced. */}
      <div
        class:list={[
          "shrink-0 md:mb-0 md:block md:w-72",
          profile.headshot ? "mb-8 w-24 sm:w-28" : "hidden",
        ]}
      >
        <div class="relative">
          <div
            aria-hidden="true"
            class="absolute -right-3 -bottom-3 -z-10 hidden h-full w-full rounded-2xl bg-accent/20 md:block"
          >
          </div>
          {
            profile.headshot ? (
              <img
                src={profile.headshot}
                alt=""
                width="288"
                height="360"
                class="aspect-[4/5] w-full rounded-2xl border border-border object-cover"
              />
            ) : (
              <div class="grid aspect-[4/5] w-full place-items-center rounded-2xl border border-border bg-surface text-3xl font-semibold tracking-tight text-faint md:text-4xl">
                cr
              </div>
            )
          }
        </div>
      </div>

      {/* Copy */}
      <div class="max-w-2xl">
        <h1
          id="hero-name"
          class="text-4xl font-semibold tracking-tight text-heading md:text-5xl"
        >
          {profile.name}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-body md:text-xl">
          {profile.tagline}
        </p>

        {
          profile.seeking && (
            <p class="mt-4">
              <span class="inline-flex items-center rounded-full bg-accent-subtle px-3 py-1 text-xs font-medium text-accent-text ring-1 ring-inset ring-accent/25">
                {profile.seeking}
              </span>
            </p>
          )
        }

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-[#1a1410] transition-colors hover:bg-accent-hover"
          >
            View projects
          </a>
          <a
            href={profile.resumePath}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-border-strong px-4 py-2.5 text-sm font-medium text-body transition-colors hover:border-accent hover:text-accent-text"
          >
            Résumé
          </a>
          <SocialLinks class="ml-1" />
        </div>

        {
          profile.context && (
            <p class="mt-6 text-sm text-faint">{profile.context}</p>
          )
        }
      </div>
    </div>
  </div>
</section>
