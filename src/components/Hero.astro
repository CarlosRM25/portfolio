---
import { profile } from "../data/profile";
import HeroDemo from "./HeroDemo.astro";
import SocialLinks from "./SocialLinks.astro";
---

<section
  aria-labelledby="hero-name"
  class="relative isolate overflow-hidden"
>
  {/* Warm ambient glow, upper-right. Purely decorative. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-[-20%] -z-10 h-[30rem] w-[30rem] rounded-full bg-accent/10 blur-3xl sm:right-[-5%] md:right-[6%]"
  >
  </div>

  <div class="page-shell pt-16 pb-14 md:pt-24 md:pb-20">
    {/*
      Copy first in the DOM, and a plain row rather than row-reverse. These
      render identically side by side at md and up, but below the breakpoint
      there is no flex container and the children simply stack in source
      order. The old order put the chart card above the name, so a phone
      visitor's first screen was a chart belonging to nobody and the name
      started 641px down.
    */}
    <div class="md:flex md:items-center md:gap-14">
      {/* Copy */}
      <div class="max-w-2xl">
        <h1
          id="hero-name"
          class="text-4xl font-semibold tracking-tight text-heading md:text-5xl"
        >
          {profile.name}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-body md:text-xl">
          {profile.tagline}
        </p>

        {
          profile.seeking && (
            <p class="mt-4">
              <span class="inline-flex items-center rounded-full bg-accent-subtle px-3 py-1 text-xs font-medium text-accent-text ring-1 ring-inset ring-accent/25">
                {profile.seeking}
              </span>
            </p>
          )
        }

        {/*
          One primary action, not three competing ones. The demo card to the
          side already argues for itself, so the button sends visitors to see
          it in motion rather than repeating "view projects"; the projects
          grid is one scroll away regardless. Résumé and the icon links are
          still here, just no longer dressed as equal-weight buttons.
        */}
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href="/demo"
            class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-[#1a1410] transition-colors hover:bg-accent-hover"
          >
            Try the live demo
          </a>
          <a
            href={profile.resumePath}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-muted underline-offset-4 transition-colors hover:text-accent-text hover:underline"
          >
            Résumé
          </a>
          <SocialLinks class="-ml-2" />
        </div>

        {
          profile.context && (
            <p class="mt-6 text-sm text-faint">{profile.context}</p>
          )
        }
      </div>

      {/*
        The hero's one visual: a live chart from the agent demo, not a
        portrait. Peer/boss feedback (2026-09-11): attention follows size,
        contrast and motion before text; a static headshot doesn't give a
        first-time visitor anything to look at before they've read a word.
        This does, and it's true rather than decorative: it's the actual
        output of the actual project one section down.
      */}
      <div class="mt-10 shrink-0 md:mt-0 md:w-[22rem]">
        <HeroDemo />
      </div>
    </div>
  </div>
</section>
